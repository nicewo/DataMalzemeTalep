<Window
    x:Class="DataMalzemeTalep.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="DATA OTOMASYON · Malzeme Liste"
    Width="1440"
    Height="900"
    MinWidth="820"
    MinHeight="560"
    Background="{StaticResource AppBackground}"
    FontFamily="Segoe UI"
    Foreground="{StaticResource TextPrimary}"
    ResizeMode="CanResize"
    SizeChanged="MainWindow_SizeChanged"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="42"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#0A1020"
            BorderBrush="#26354D"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Orientation="Horizontal">
                    <Image
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="/AltinLogo.png" />
                    <TextBlock
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#D9A514"
                        Text="DATA OTOMASYON" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#D5DEEC"
                        Text="  ·  Malzeme Liste" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MinimizeWindow_Click"
                    Content="—"
                    FontSize="16"
                    Foreground="#CBD5E1" />
                <Button
                    Grid.Column="3"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MaximizeWindow_Click"
                    Content="□"
                    FontSize="13"
                    Foreground="#CBD5E1" />
                <Button
                    Grid.Column="4"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseWindow_Click"
                    Content="×"
                    FontSize="18"
                    Foreground="#CBD5E1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C42B1C" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!--  Sidebar  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="#202D42"
            BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="5,4,0,34" Orientation="Horizontal">
                        <Image
                            Width="90"
                            Height="89"
                            VerticalAlignment="Center"
                            Source="/AltinLogo.png" />

                        <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#D9A514"
                                Text="DATA OTOMASYON" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#F8FAFC"
                                Text="Malzeme liste" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="12,0,0,10"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#61718A"
                        Text="ÇALIŞMA ALANI" />
                    <Button
                        x:Name="DashboardNav"
                        Background="#3B3017"
                        Click="DashboardNav_Click"
                        Foreground="#F2C14E"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Text="▦" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Genel Bakış" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NewRequestNav"
                        Click="NewRequestNav_Click"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="＋" />
                            <TextBlock VerticalAlignment="Center" Text="Yeni liste" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PreviousNav"
                        Click="PreviousNav_Click"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Text="▤" />
                            <TextBlock VerticalAlignment="Center" Text="Önceki listeler" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        Margin="12,28,0,10"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#61718A"
                        Text="YÖNETİM" />
                    <Button
                        x:Name="CatalogNav"
                        Click="CatalogNav_Click"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="▣" />
                            <TextBlock VerticalAlignment="Center" Text="Malzeme Kataloğu" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border
                    Margin="0,18,0,0"
                    Padding="12"
                    Background="#131F33"
                    BorderBrush="#26354D"
                    BorderThickness="1"
                    CornerRadius="10"
                    DockPanel.Dock="Bottom">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource SuccessBrush}" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D5E2F2"
                                Text="Yerel çalışma alanı" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,10"
                            FontSize="10"
                            Foreground="#8192AA"
                            LineHeight="15"
                            Text="Dosyalar bilgisayarınızda saklanır."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,2,0,7"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#D5E2F2"
                            Text="SON LİSTELER" />
                        <ListBox
                            x:Name="SidebarSavedLists"
                            Height="245"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#D5E2F2"
                            MouseDoubleClick="SidebarSavedLists_MouseDoubleClick"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="7,8" />
                                    <Setter Property="Margin" Value="0,0,0,3" />
                                    <Setter Property="Background" Value="#17243A" />
                                    <Setter Property="Foreground" Value="#D5E2F2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border
                                                    x:Name="ItemBorder"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#263A59" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#334B70" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="9"
                                            Foreground="#8192AA"
                                            Text="{Binding ModifiedText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!--  Main area  -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Background="{StaticResource AppBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#0D1425"
                BorderBrush="#202D42"
                BorderThickness="0,0,0,1">
                <Grid Margin="32,0,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Name="PageTitle"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Text="Genel Bakış" />
                        <TextBlock
                            x:Name="PageSubtitle"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondary}"
                            Text="Malzeme listelerinizi tek yerden yönetin." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Click="ExportExcel_Click"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="16"
                                    Text="↓" />
                                <TextBlock VerticalAlignment="Center" Text="Excel Çıkar" />
                            </StackPanel>
                        </Button>
                        <Button Click="ExportPdf_Click" Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="16"
                                    Text="↓" />
                                <TextBlock VerticalAlignment="Center" Text="PDF Çıkar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="MainContentScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="32,28,32,32">
                    <!--  Dashboard  -->
                    <StackPanel x:Name="DashboardPanel">
                        <Border
                            Margin="0,0,0,24"
                            Padding="28"
                            ClipToBounds="True"
                            CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#1B2A4B" />
                                    <GradientStop Offset="0.58" Color="#20234A" />
                                    <GradientStop Offset="1" Color="#17243A" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="DashboardArtColumn" Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel MaxWidth="650" VerticalAlignment="Center">
                                    <Border
                                        Margin="0,0,0,14"
                                        Padding="9,5"
                                        HorizontalAlignment="Left"
                                        Background="#4A3A13"
                                        CornerRadius="5">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="#F2C14E"
                                            Text="MALZEME YÖNETİMİ" />
                                    </Border>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="#F8FAFC"
                                        Text="Listelerinizi yönetin."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,10,0,22"
                                        FontSize="13"
                                        Foreground="#B5C3DA"
                                        LineHeight="21"
                                        Text="Yeni bir malzeme listesi oluşturun, kayıtlı listelerinize ulaşın ve çıktılarınızı hazırlayın."
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Click="NewRequestNav_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                FontSize="18"
                                                Text="＋" />
                                            <TextBlock VerticalAlignment="Center" Text="Yeni liste Oluştur" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid
                                    x:Name="DashboardHeroArt"
                                    Grid.Column="1"
                                    Width="130"
                                    Height="150"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        Width="144"
                                        Height="144"
                                        Opacity="0.8"
                                        Stroke="#6D571B"
                                        StrokeThickness="1" />
                                    <Ellipse
                                        Width="108"
                                        Height="108"
                                        Opacity="0.8"
                                        Stroke="#D9A514"
                                        StrokeThickness="1" />
                                    <Ellipse
                                        Width="72"
                                        Height="72"
                                        Fill="#161616" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="26"
                                        FontWeight="Bold"
                                        Foreground="#D9A514"
                                        Text="D" />
                                    <Ellipse
                                        Width="11"
                                        Height="11"
                                        Margin="0,14,15,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Fill="#A5B4FC" />
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Margin="18,0,0,18"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Fill="#34D399" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid x:Name="DashboardStatsGrid" Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="StatsRow1" Height="Auto" />
                                <RowDefinition x:Name="StatsRow2" Height="Auto" />
                                <RowDefinition x:Name="StatsRow3" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="StatsColumn1" Width="*" />
                                <ColumnDefinition x:Name="StatsColumn2" Width="*" />
                                <ColumnDefinition x:Name="StatsColumn3" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="TotalListsCard"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Padding="19"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="TOPLAM liste" />
                                    <TextBlock
                                        x:Name="TotalRequestsText"
                                        Margin="0,12,0,5"
                                        FontSize="27"
                                        FontWeight="SemiBold"
                                        Text="0" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#7F91AA"
                                        Text="Kaydedilmiş Excel listeleri"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="LastCreatedCard"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="6,0"
                                Padding="19"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="SON OLUŞTURULAN" />
                                    <TextBlock
                                        x:Name="LastCreatedNameText"
                                        Margin="0,12,0,5"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="LastCreatedDateText"
                                        FontSize="11"
                                        Foreground="#7F91AA"
                                        Text="Henüz liste kaydı yok"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="CatalogStatsCard"
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                Padding="19"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="MALZEME KATALOĞU" />
                                    <TextBlock
                                        x:Name="CatalogCountText"
                                        Margin="0,12,0,5"
                                        FontSize="27"
                                        FontWeight="SemiBold"
                                        Text="0" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#7F91AA"
                                        Text="Katalogdaki malzeme sayısı"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="DashboardBottomGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="QuickActionsRow" Height="*" />
                                <RowDefinition x:Name="GettingStartedRow" Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="QuickActionsColumn" Width="1.25*" />
                                <ColumnDefinition x:Name="GettingStartedColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="QuickActionsCard"
                                Grid.Row="0"
                                Margin="0,0,12,0"
                                Padding="18"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Hızlı işlemler" />
                                    <TextBlock
                                        Margin="0,5,0,18"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="Sık kullanılan işlemlere buradan ulaşın." />
                                    <Button
                                        Margin="0,0,0,10"
                                        HorizontalContentAlignment="Left"
                                        Click="NewRequestNav_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,12,0"
                                                Background="#3D3217"
                                                CornerRadius="7">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="20"
                                                    Foreground="#C7D2FE"
                                                    Text="＋" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="Yeni liste oluştur" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondary}"
                                                    Text="Malzemeleri seç ve miktarları gir" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        HorizontalContentAlignment="Left"
                                        Click="PreviousNav_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,12,0"
                                                Background="#1E4350"
                                                CornerRadius="7">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="17"
                                                    Foreground="#6EE7B7"
                                                    Text="▤" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="Önceki listeleri aç" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondary}"
                                                    Text="Kayıtlı Excel listelerine göz at" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="GettingStartedCard"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="18"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Başlarken" />
                                    <TextBlock
                                        Margin="0,5,0,18"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="İş akışı" />
                                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                                        <Border
                                            Width="27"
                                            Height="27"
                                            Background="#26345A"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="#C7D2FE"
                                                Text="1" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="liste oluştur" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondary}"
                                                Text="Yeni bir liste başlat." />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                                        <Border
                                            Width="27"
                                            Height="27"
                                            Background="#26345A"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="#C7D2FE"
                                                Text="2" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Malzemeleri ekle" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondary}"
                                                Text="Katalogdan ürün ve miktar seç." />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            Width="27"
                                            Height="27"
                                            Background="#26345A"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="#C7D2FE"
                                                Text="3" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Excel ve PDF çıktısı" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondary}"
                                                Text="Listenizi kaydedip paylaş." />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="NewRequestPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    x:Name="CurrentListTitle"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="Liste düzenleme" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Değişiklikler açık olan Excel listesine kaydedilir." />
                            </StackPanel>

                        </Grid>

                        <Border
                            Margin="0,0,0,18"
                            Padding="22"
                            Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.55*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Kategori" />
                                        <ComboBox
                                            x:Name="CategoryCombo"
                                            Height="40"
                                            Background="#17243A"
                                            BorderBrush="#33445F"
                                            Foreground="#F1F5F9"
                                            SelectionChanged="CategoryCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Marka" />
                                        <ComboBox
                                            x:Name="BrandCombo"
                                            Height="40"
                                            Background="#17243A"
                                            BorderBrush="#33445F"
                                            Foreground="#F1F5F9"
                                            SelectionChanged="BrandCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Model" />
                                        <ComboBox
                                            x:Name="ProductCombo"
                                            Height="40"
                                            Background="#17243A"
                                            BorderBrush="#33445F"
                                            Foreground="#F1F5F9"
                                            SelectionChanged="ProductCombo_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="#F1F5F9"
                                                            Text="{Binding Model}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#94A3B8"
                                                            Text=" (" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#94A3B8"
                                                            Text="{Binding Specifications}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#94A3B8"
                                                            Text=")" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Miktar" />
                                        <TextBox
                                            x:Name="QuantityTextBox"
                                            Height="40"
                                            Padding="8"
                                            Background="#17243A"
                                            BorderBrush="#33445F"
                                            Foreground="#F1F5F9"
                                            Text="1" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="4"
                                        Height="40"
                                        VerticalAlignment="Bottom"
                                        Click="AddItem_Click"
                                        Content="＋ Listeye Ekle"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    x:Name="ProductDescriptionText"
                                    Margin="0,12,0,0"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Ürün seçildiğinde teknik açıklama burada görünür." />
                            </StackPanel>
                        </Border>
                        <Border Padding="22" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="liste listesi" />
                                        <TextBlock
                                            x:Name="RequestCountText"
                                            Margin="0,5,0,0"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Henüz ürün eklenmedi" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="RequestNameTextBox"
                                        Grid.Column="1"
                                        Width="230"
                                        Height="36"
                                        Padding="8"
                                        Background="#17243A"
                                        BorderBrush="#33445F"
                                        Foreground="#F1F5F9"
                                        Text="Malzeme Talebi" />
                                </Grid>
                                <DataGrid
                                    x:Name="RequestGrid"
                                    MinHeight="240"
                                    MaxHeight="420"
                                    AlternatingRowBackground="#152238"
                                    AutoGenerateColumns="False"
                                    Background="#111C30"
                                    BorderBrush="#26354D"
                                    CanUserAddRows="False"
                                    Foreground="#E2E8F0"
                                    GridLinesVisibility="Horizontal"
                                    IsReadOnly="True"
                                    RowBackground="#111C30">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1.1*"
                                            Binding="{Binding Category}"
                                            Header="Kategori" />
                                        <DataGridTextColumn
                                            Width="0.9*"
                                            Binding="{Binding Brand}"
                                            Header="Marka" />
                                        <DataGridTextColumn
                                            Width="1.1*"
                                            Binding="{Binding Model}"
                                            Header="Model" />
                                        <DataGridTextColumn
                                            Width="2*"
                                            Binding="{Binding Specifications}"
                                            Header="Açıklama / Teknik Özellik" />
                                        <DataGridTextColumn
                                            Width="0.65*"
                                            Binding="{Binding Quantity}"
                                            Header="Miktar" />
                                        <DataGridTextColumn
                                            Width="0.65*"
                                            Binding="{Binding Unit}"
                                            Header="Birim" />
                                        <DataGridTemplateColumn Width="80" Header="">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Padding="7,4"
                                                        Background="#42212D"
                                                        BorderThickness="0"
                                                        Click="RemoveItem_Click"
                                                        Content="Kaldır"
                                                        Foreground="#FCA5A5"
                                                        Tag="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="StatusText"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="Liste henüz kaydedilmedi." />
                                    <Button
                                        Grid.Column="1"
                                        Click="SaveRequest_Click"
                                        Content="Kaydet"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="PreviousPanel" Visibility="Collapsed">
                        <Border Padding="26" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="Önceki listeler" />
                                <TextBlock
                                    Margin="0,6,0,18"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Bir talebe çift tıklayarak yeniden açabilirsiniz." />
                                <ListBox
                                    x:Name="PreviousList"
                                    MinHeight="260"
                                    Padding="8"
                                    Background="#111C30"
                                    BorderBrush="#26354D"
                                    Foreground="#E2E8F0"
                                    MouseDoubleClick="PreviousList_MouseDoubleClick" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="CatalogPanel" Visibility="Collapsed">
                        <Border Padding="26" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="Malzeme Kataloğu" />
                                <TextBlock
                                    Margin="0,6,0,16"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Ürün ekleyin, hücrelere tıklayarak bilgileri düzenleyin veya seçili ürünü silin. Değişiklikler catalog.xml dosyasına kaydedilir."
                                    TextWrapping="Wrap" />
                                <WrapPanel Margin="0,0,0,14">
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="14,8"
                                        Click="AddCatalogItem_Click"
                                        Content="+ Yeni Ürün"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="14,8"
                                        Click="ImportCatalogPdf_Click"
                                        Content="PDF'den Oku"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Malzeme listesi PDF'sinden marka, model ve açıklamaları kataloğa aktar" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="14,8"
                                        Click="ExportCatalogExcel_Click"
                                        Content="Excel'e Aktar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Kataloğu Excel dosyası olarak dışa aktar" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="14,8"
                                        Click="ImportCatalogExcel_Click"
                                        Content="Excel'den İçe Aktar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Excel kataloğunu ürün koduna göre karşılaştırıp güncelle veya yeni ürün ekle" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="14,8"
                                        Click="DeleteCatalogItem_Click"
                                        Content="Seçilileri Sil"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Padding="14,8"
                                        Click="SaveCatalog_Click"
                                        Content="Kataloğu Kaydet"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </WrapPanel>
                                <DataGrid
                                    x:Name="CatalogGrid"
                                    MinHeight="300"
                                    AlternatingRowBackground="#152238"
                                    AutoGenerateColumns="False"
                                    Background="#111C30"
                                    BorderBrush="#26354D"
                                    CanUserAddRows="False"
                                    Foreground="#E2E8F0"
                                    IsReadOnly="False"
                                    PreviewMouseWheel="CatalogGrid_PreviewMouseWheel"
                                    RowBackground="#111C30"
                                    SelectionMode="Extended"
                                    SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1*"
                                            Binding="{Binding Category}"
                                            Header="Kategori" />
                                        <DataGridTextColumn
                                            Width="1*"
                                            Binding="{Binding Brand}"
                                            Header="Marka" />
                                        <DataGridTextColumn
                                            Width="1.3*"
                                            Binding="{Binding Model}"
                                            Header="Model" />
                                        <DataGridTextColumn
                                            Width="2*"
                                            Binding="{Binding Specifications}"
                                            Header="Teknik özellikler" />
                                        <DataGridTextColumn
                                            Width="1.5*"
                                            Binding="{Binding Description}"
                                            Header="Açıklama" />
                                        <DataGridTextColumn
                                            Width="0.7*"
                                            Binding="{Binding Unit}"
                                            Header="Birim" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>