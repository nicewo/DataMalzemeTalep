<Window
    x:Class="DataMalzemeTalep.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Data Malzeme liste"
    Width="1440"
    Height="900"
    MinWidth="1120"
    MinHeight="720"
    Background="{StaticResource AppBackground}"
    FontFamily="Segoe UI"
    Foreground="{StaticResource TextPrimary}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBackground}"
            BorderBrush="#202D42"
            BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="5,4,0,34" Orientation="Horizontal">
                        <Border
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="#111111"
                            BorderBrush="#D9A514"
                            BorderThickness="1"
                            CornerRadius="12">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#D9A514"
                                Text="D" />
                        </Border>
                        <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#D9A514"
                                Text="DATA OTOMASYON" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#F8FAFC"
                                Text="Malzeme liste" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="12,0,0,10"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#61718A"
                        Text="ÇALIŞMA ALANI" />
                    <Button
                        x:Name="DashboardNav"
                        Background="#3B3017"
                        Click="DashboardNav_Click"
                        Foreground="#F2C14E"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Text="▦" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Genel Bakış" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NewRequestNav"
                        Click="NewRequestNav_Click"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="＋" />
                            <TextBlock VerticalAlignment="Center" Text="Yeni liste" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PreviousNav"
                        Click="PreviousNav_Click"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Text="▤" />
                            <TextBlock VerticalAlignment="Center" Text="Önceki listeler" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        Margin="12,28,0,10"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#61718A"
                        Text="YÖNETİM" />
                    <Button
                        x:Name="CatalogNav"
                        Click="CatalogNav_Click"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="▣" />
                            <TextBlock VerticalAlignment="Center" Text="Malzeme Kataloğu" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border
                    Margin="0,18,0,0"
                    Padding="12"
                    Background="#131F33"
                    BorderBrush="#26354D"
                    BorderThickness="1"
                    CornerRadius="10"
                    DockPanel.Dock="Bottom">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource SuccessBrush}" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#D5E2F2"
                                Text="Yerel çalışma alanı" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="10"
                            Foreground="#8192AA"
                            LineHeight="15"
                            Text="Dosyalar bilgisayarınızda saklanır."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!--  Main area  -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#0D1425"
                BorderBrush="#202D42"
                BorderThickness="0,0,0,1">
                <Grid Margin="32,0,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Name="PageTitle"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Text="Genel Bakış" />
                        <TextBlock
                            x:Name="PageSubtitle"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondary}"
                            Text="Malzeme listelerinizi tek yerden yönetin." />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Click="ExportPdf_Click"
                        Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,9,0"
                                FontSize="16"
                                Text="↓" />
                            <TextBlock VerticalAlignment="Center" Text="PDF Çıkar" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="32,28,32,32">
                    <!--  Dashboard  -->
                    <StackPanel x:Name="DashboardPanel">
                        <Border
                            Margin="0,0,0,24"
                            Padding="28"
                            ClipToBounds="True"
                            CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#1B2A4B" />
                                    <GradientStop Offset="0.58" Color="#20234A" />
                                    <GradientStop Offset="1" Color="#17243A" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel MaxWidth="650" VerticalAlignment="Center">
                                    <Border
                                        Margin="0,0,0,14"
                                        Padding="9,5"
                                        HorizontalAlignment="Left"
                                        Background="#4A3A13"
                                        CornerRadius="5">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="#F2C14E"
                                            Text="MALZEME YÖNETİMİ" />
                                    </Border>
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="#F8FAFC"
                                        Text="listelerinizi kolayca yönetin."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,10,0,22"
                                        FontSize="13"
                                        Foreground="#B5C3DA"
                                        LineHeight="21"
                                        Text="Yeni bir malzeme listesi oluşturun, kayıtlı listelerinize ulaşın ve çıktılarınızı hazırlayın."
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Click="NewRequestNav_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                FontSize="18"
                                                Text="＋" />
                                            <TextBlock VerticalAlignment="Center" Text="Yeni liste Oluştur" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid
                                    Grid.Column="1"
                                    Width="150"
                                    Height="150"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        Width="144"
                                        Height="144"
                                        Opacity="0.8"
                                        Stroke="#6D571B"
                                        StrokeThickness="1" />
                                    <Ellipse
                                        Width="108"
                                        Height="108"
                                        Opacity="0.8"
                                        Stroke="#D9A514"
                                        StrokeThickness="1" />
                                    <Ellipse
                                        Width="72"
                                        Height="72"
                                        Fill="#161616" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="26"
                                        FontWeight="Bold"
                                        Foreground="#D9A514"
                                        Text="D" />
                                    <Ellipse
                                        Width="11"
                                        Height="11"
                                        Margin="0,14,15,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Fill="#A5B4FC" />
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Margin="18,0,0,18"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Fill="#34D399" />
                                </Grid>
                            </Grid>
                        </Border>

                        <UniformGrid Margin="0,0,0,24" Columns="3">
                            <Border
                                Margin="0,0,12,0"
                                Padding="19"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="TOPLAM liste" />
                                    <TextBlock
                                        Margin="0,12,0,5"
                                        FontSize="27"
                                        FontWeight="SemiBold"
                                        x:Name="TotalRequestsText"
                                        Text="0" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#7F91AA"
                                        Text="Kaydedilmiş Excel listeleri"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Margin="6,0"
                                Padding="19"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="SON OLUŞTURULAN" />
                                    <TextBlock
                                        Margin="0,12,0,5"
                                        FontSize="27"
                                        FontWeight="SemiBold"
                                        Text="—" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#7F91AA"
                                        Text="Henüz liste kaydı yok"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                Margin="12,0,0,0"
                                Padding="19"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="MALZEME KATALOĞU" />
                                    <TextBlock
                                        Margin="0,12,0,5"
                                        FontSize="27"
                                        FontWeight="SemiBold"
                                        x:Name="CatalogCountText"
                                        Text="0" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#7F91AA"
                                        Text="Katalogdaki malzeme sayısı"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Margin="0,0,12,0"
                                Padding="22"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Hızlı işlemler" />
                                    <TextBlock
                                        Margin="0,5,0,18"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="Sık kullanılan işlemlere buradan ulaşın." />
                                    <Button
                                        Margin="0,0,0,10"
                                        HorizontalContentAlignment="Left"
                                        Click="NewRequestNav_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,12,0"
                                                Background="#3D3217"
                                                CornerRadius="7">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="20"
                                                    Foreground="#C7D2FE"
                                                    Text="＋" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="Yeni liste oluştur" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondary}"
                                                    Text="Malzemeleri seç ve miktarları gir" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        HorizontalContentAlignment="Left"
                                        Click="PreviousNav_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,12,0"
                                                Background="#1E4350"
                                                CornerRadius="7">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="17"
                                                    Foreground="#6EE7B7"
                                                    Text="▤" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="Önceki listeleri aç" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondary}"
                                                    Text="Kayıtlı Excel listelerine göz at" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="22"
                                Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Başlarken" />
                                    <TextBlock
                                        Margin="0,5,0,18"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="İş akışı" />
                                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                                        <Border
                                            Width="27"
                                            Height="27"
                                            Background="#26345A"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="#C7D2FE"
                                                Text="1" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="liste oluştur" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondary}"
                                                Text="Yeni bir liste başlat." />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                                        <Border
                                            Width="27"
                                            Height="27"
                                            Background="#26345A"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="#C7D2FE"
                                                Text="2" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Malzemeleri ekle" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondary}"
                                                Text="Katalogdan ürün ve miktar seç." />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            Width="27"
                                            Height="27"
                                            Background="#26345A"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="#C7D2FE"
                                                Text="3" />
                                        </Border>
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Excel ve PDF çıktısı" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondary}"
                                                Text="Listenizi kaydedip paylaş." />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="NewRequestPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CurrentListTitle" FontSize="22" FontWeight="Bold" Text="Liste düzenleme" />
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextSecondary}" Text="Değişiklikler açık olan Excel listesine kaydedilir." />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="ExportPdf_Click" Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,9,0" FontSize="16" Text="↓" />
                                    <TextBlock VerticalAlignment="Center" Text="PDF Çıkar" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            FontSize="23"
                            FontWeight="Bold"
                            Text="Yeni malzeme listesi" />
                        <TextBlock
                            Margin="0,6,0,20"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondary}"
                            Text="Katalogdan ürün seçin, miktarı belirleyin ve listeye ekleyin." />
                        <Border
                            Margin="0,0,0,18"
                            Padding="22"
                            Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Kategori" />
                                        <ComboBox
                                            x:Name="CategoryCombo"
                                            Height="40"
                                            Background="#17243A"
                                            BorderBrush="#33445F"
                                            Foreground="#F1F5F9"
                                            SelectionChanged="CategoryCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Malzeme / ürün" />
                                        <ComboBox
                                            x:Name="ProductCombo"
                                            Height="40"
                                            Background="#17243A"
                                            BorderBrush="#33445F"
                                            DisplayMemberPath="DisplayName"
                                            Foreground="#F1F5F9"
                                            SelectionChanged="ProductCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Miktar" />
                                        <TextBox
                                            x:Name="QuantityTextBox"
                                            Height="40"
                                            Padding="8"
                                            Background="#17243A"
                                            BorderBrush="#33445F"
                                            Foreground="#F1F5F9"
                                            Text="1" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="3"
                                        Height="40"
                                        VerticalAlignment="Bottom"
                                        Click="AddItem_Click"
                                        Content="＋ Listeye Ekle"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    x:Name="ProductDescriptionText"
                                    Margin="0,12,0,0"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Ürün seçildiğinde teknik açıklama burada görünür." />
                            </StackPanel>
                        </Border>
                        <Border Padding="22" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="liste listesi" />
                                        <TextBlock
                                            x:Name="RequestCountText"
                                            Margin="0,5,0,0"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Henüz ürün eklenmedi" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="RequestNameTextBox"
                                        Grid.Column="1"
                                        Width="230"
                                        Height="36"
                                        Padding="8"
                                        Background="#17243A"
                                        BorderBrush="#33445F"
                                        Foreground="#F1F5F9"
                                        Text="Malzeme Talebi" />
                                </Grid>
                                <DataGrid
                                    x:Name="RequestGrid"
                                    MinHeight="240"
                                    MaxHeight="420"
                                    AlternatingRowBackground="#152238"
                                    AutoGenerateColumns="False"
                                    Background="#111C30"
                                    BorderBrush="#26354D"
                                    CanUserAddRows="False"
                                    Foreground="#E2E8F0"
                                    GridLinesVisibility="Horizontal"
                                    IsReadOnly="True"
                                    RowBackground="#111C30">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1*"
                                            Binding="{Binding Category}"
                                            Header="Kategori" />
                                        <DataGridTextColumn
                                            Width="1.8*"
                                            Binding="{Binding DisplayName}"
                                            Header="Marka / Model" />
                                        <DataGridTextColumn
                                            Width="2*"
                                            Binding="{Binding Specifications}"
                                            Header="Teknik özellikler" />
                                        <DataGridTextColumn
                                            Width="0.7*"
                                            Binding="{Binding Quantity}"
                                            Header="Miktar" />
                                        <DataGridTextColumn
                                            Width="0.7*"
                                            Binding="{Binding Unit}"
                                            Header="Birim" />
                                        <DataGridTemplateColumn Width="80" Header="">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Padding="7,4"
                                                        Background="#42212D"
                                                        BorderThickness="0"
                                                        Click="RemoveItem_Click"
                                                        Content="Kaldır"
                                                        Foreground="#FCA5A5"
                                                        Tag="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="StatusText"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="Liste henüz kaydedilmedi." />
                                    <Button
                                        Grid.Column="1"
                                        Click="SaveRequest_Click"
                                        Content="Excel'e Kaydet"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="PreviousPanel" Visibility="Collapsed">
                        <Border Padding="26" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="Önceki listeler" />
                                <TextBlock
                                    Margin="0,6,0,18"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Bir talebe çift tıklayarak yeniden açabilirsiniz." />
                                <ListBox
                                    x:Name="PreviousList"
                                    MinHeight="260"
                                    Padding="8"
                                    Background="#111C30"
                                    BorderBrush="#26354D"
                                    Foreground="#E2E8F0"
                                    MouseDoubleClick="PreviousList_MouseDoubleClick" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="CatalogPanel" Visibility="Collapsed">
                        <Border Padding="26" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="Malzeme Kataloğu" />
                                <TextBlock
                                    Margin="0,6,0,18"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="Katalog dosyası Belgeler/DataMalzemeliste/Data/catalog.xml konumundadır."
                                    TextWrapping="Wrap" />
                                <DataGrid
                                    x:Name="CatalogGrid"
                                    MinHeight="300"
                                    AlternatingRowBackground="#152238"
                                    AutoGenerateColumns="False"
                                    Background="#111C30"
                                    BorderBrush="#26354D"
                                    CanUserAddRows="False"
                                    Foreground="#E2E8F0"
                                    IsReadOnly="True"
                                    RowBackground="#111C30">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1*"
                                            Binding="{Binding Category}"
                                            Header="Kategori" />
                                        <DataGridTextColumn
                                            Width="1*"
                                            Binding="{Binding Brand}"
                                            Header="Marka" />
                                        <DataGridTextColumn
                                            Width="1.3*"
                                            Binding="{Binding Model}"
                                            Header="Model" />
                                        <DataGridTextColumn
                                            Width="2*"
                                            Binding="{Binding Specifications}"
                                            Header="Teknik özellikler" />
                                        <DataGridTextColumn
                                            Width="0.7*"
                                            Binding="{Binding Unit}"
                                            Header="Birim" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>